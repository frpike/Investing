// Writes the course content (modules, lessons, question ids) as a SQL migration, so it can be
// loaded by pasting into Supabase's SQL editor or with `supabase db push`. Re-run after editing
// /content:  npm run content:sql
import { writeFileSync } from "node:fs";
import { contentRows } from "../src/lib/content-sync";

const q = (v: unknown): string =>
  v === null || v === undefined ? "null"
  : Array.isArray(v) ? `array[${v.map(q).join(", ")}]::text[]`
  : typeof v === "number" || typeof v === "boolean" ? String(v)
  : `'${String(v).replace(/'/g, "''")}'`;

function upsert(table: string, rows: Record<string, unknown>[]) {
  if (!rows.length) return "";
  const cols = Object.keys(rows[0]);
  const values = rows.map((r) => `  (${cols.map((c) => q(r[c])).join(", ")})`).join(",\n");
  const updates = cols.filter((c) => c !== "id").map((c) => `${c} = excluded.${c}`).join(", ");
  return `insert into public.${table} (${cols.join(", ")}) values\n${values}\non conflict (id) do update set ${updates};\n`;
}

const { modules, lessons, questions } = contentRows();
const sql = `-- Generated by scripts/content-sql.mts from /content. Do not edit by hand.\n-- Course content that progress tables refer to. Safe to run more than once.\n\n${upsert("course_modules", modules)}\n${upsert("lessons", lessons)}\n${upsert("quiz_questions", questions)}`;
writeFileSync(new URL("../supabase/migrations/20261024000000_course_content.sql", import.meta.url), sql);
console.log(`Wrote ${modules.length} modules, ${lessons.length} lessons, ${questions.length} questions.`);
